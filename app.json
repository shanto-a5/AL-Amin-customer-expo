{
  "expo": {
    "name": "AllPay BD",
    "slug": "allpay-bd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/allpay-logo.jpeg",
    "scheme": "allpay",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1120",
    "ios": {
      "bundleIdentifier": "com.allpaybd.app"
    },
    "android": {
      "icon": "./assets/images/allpay-logo.jpeg",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/allpay-logo.jpeg",
        "backgroundColor": "#0B1120"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.allpaybd.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/allpay-logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120",
          "image": "./assets/images/allpay-logo.jpeg",
          "imageWidth": 200
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "installationIdEnabled": true
        }
      ],
      "./plugins/withNotificationChannel"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6dab74b1-9f19-4a04-ba49-fbcb5065f03a"
      }
    }
  }
}
